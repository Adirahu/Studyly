# Gemini has a free usage tier with model-specific rate limits.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
# Backup models, tried in order when the main model hits a free-tier limit or is busy.
# Each model has its own free daily allowance (gemini-3.6-flash allows only 20 requests a day on the free tier).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-flash-latest
PORT=3000
HOST=127.0.0.1

# Optional local mode (requires Ollama and a downloaded model).
# AI_PROVIDER=ollama
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_URL=http://127.0.0.1:11434

# Optional OpenAI mode (may incur charges).
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
